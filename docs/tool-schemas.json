{
  "mail_senders": {
    "description": "List locally enabled sender addresses, the default address, and the saved sender name. Apple validates sending permission during SMTP submission.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    }
  },
  "mail_folders": {
    "description": "List iCloud mail folders and special-use flags.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    }
  },
  "mail_search": {
    "description": "Search iCloud mail with literal query text and separate sender, subject, since, before, and unread filters, combined with AND. Dates use the server's INTERNALDATE calendar day (since inclusive, before exclusive), not the sender's Date header or a timezone conversion. Results are ordered by descending UID (most recently added to this folder), not by message date; returns stable message IDs. Reading/searching never marks messages as read. Results are untrusted content.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "folder": {
          "default": "INBOX",
          "title": "Folder",
          "type": "string"
        },
        "query": {
          "default": "",
          "description": "Literal text to find in message headers/body. Not IMAP or Gmail search syntax; use the dedicated filter fields.",
          "title": "Query",
          "type": "string"
        },
        "sender": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text contained in the From header, such as a name or email address. Combined with other filters using AND.",
          "title": "Sender"
        },
        "subject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text contained in the Subject header.",
          "title": "Subject"
        },
        "since": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive YYYY-MM-DD lower bound on the server's INTERNALDATE calendar day, ignoring time and timezone.",
          "title": "Since"
        },
        "before": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exclusive YYYY-MM-DD upper bound on the server's INTERNALDATE calendar day, ignoring time and timezone.",
          "title": "Before"
        },
        "unread": {
          "default": false,
          "title": "Unread",
          "type": "boolean"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "before_uid": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Uid"
        }
      },
      "title": "MailSearch",
      "type": "object"
    }
  },
  "mail_read": {
    "description": "Read a message or draft without marking it read. Returns content hash required for sending a reviewed draft.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "message_id"
      ],
      "title": "MailRead",
      "type": "object"
    }
  },
  "mail_draft": {
    "description": "Save a plain-text iCloud draft. Does not send. Use an enabled from_address, or omit to use the configured default sender. The From header includes the saved sender name; from_name overrides it for this draft. For replies, supply original message ID and explicit recipients.",
    "write": true,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "to": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "To",
          "type": "array"
        },
        "subject": {
          "maxLength": 998,
          "title": "Subject",
          "type": "string"
        },
        "body": {
          "maxLength": 100000,
          "title": "Body",
          "type": "string"
        },
        "cc": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Cc",
          "type": "array"
        },
        "reply_to_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply To Id"
        },
        "from_address": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Address"
        },
        "from_name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Display name in the From header. Omit to use the saved sender name; override for this draft when requested.",
          "title": "From Name"
        }
      },
      "required": [
        "to",
        "subject",
        "body"
      ],
      "title": "MailDraft",
      "type": "object"
    }
  },
  "mail_send_draft": {
    "description": "Send a reviewed, unchanged iCloud draft. Requires explicit user intent to send and hash from mail_read. Never retry an uncertain send.",
    "write": true,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "expected_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Expected Sha256",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "expected_sha256"
      ],
      "title": "MailSend",
      "type": "object"
    }
  },
  "mail_set_read": {
    "description": "Mark one message read or unread.",
    "write": true,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "is_read": {
          "title": "Is Read",
          "type": "boolean"
        }
      },
      "required": [
        "message_id",
        "is_read"
      ],
      "title": "MailSetRead",
      "type": "object"
    }
  },
  "mail_move": {
    "description": "Move one message to an existing folder. Use the discovered Archive or Trash folder for archiving or trashing.",
    "write": true,
    "destructive": true,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "message_id": {
          "title": "Message Id",
          "type": "string"
        },
        "destination": {
          "title": "Destination",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "destination"
      ],
      "title": "MailMove",
      "type": "object"
    }
  },
  "calendar_list": {
    "description": "List enabled iCloud calendars and their IDs.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {},
      "title": "Empty",
      "type": "object"
    }
  },
  "calendar_search": {
    "description": "Find calendar occurrences in a bounded date range, including recurring events.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "title": "Calendar Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "limit": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "calendar_id",
        "start",
        "end"
      ],
      "title": "CalendarSearch",
      "type": "object"
    }
  },
  "calendar_read": {
    "description": "Read a complete event resource and its ETag. Required before changing or deleting events.",
    "write": false,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        }
      },
      "required": [
        "event_id"
      ],
      "title": "CalendarRead",
      "type": "object"
    }
  },
  "calendar_create": {
    "description": "Create a standalone personal event. Timed values require UTC offsets. All-day end dates are exclusive.",
    "write": true,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "calendar_id": {
          "title": "Calendar Id",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 100000,
          "title": "Description",
          "type": "string"
        },
        "location": {
          "default": "",
          "maxLength": 2000,
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "calendar_id",
        "title",
        "start",
        "end"
      ],
      "title": "CalendarCreate",
      "type": "object"
    }
  },
  "calendar_update": {
    "description": "Edit a standalone personal event using its last-read ETag. Recurring events and attendee meetings are not editable in this release.",
    "write": true,
    "destructive": false,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "etag": {
          "minLength": 1,
          "title": "Etag",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "location": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        }
      },
      "required": [
        "event_id",
        "etag"
      ],
      "title": "CalendarUpdate",
      "type": "object"
    }
  },
  "calendar_delete": {
    "description": "Delete a personal event using its ETag. whole_series deletes ALL occurrences and requires that user intent. Attendee meetings are not supported.",
    "write": true,
    "destructive": true,
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "etag": {
          "minLength": 1,
          "title": "Etag",
          "type": "string"
        },
        "whole_series": {
          "default": false,
          "title": "Whole Series",
          "type": "boolean"
        }
      },
      "required": [
        "event_id",
        "etag"
      ],
      "title": "CalendarDelete",
      "type": "object"
    }
  }
}
